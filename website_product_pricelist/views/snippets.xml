<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippet_options" inherit_id="website_sale.snippet_options">
        <xpath expr="//we-checkbox[@data-name='o_wsale_accordion_item']" position="before">
            <we-checkbox string="Price List" 
                data-customize-website-views="website_product_pricelist.pricelist_temp" 
                data-name="o_wsale_pricelist_view"
                data-no-preview="true"
                data-reload="/"/>
        </xpath>
    </template>
</odoo>
