<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tgm_flipbook_list" model="ir.ui.view">
        <field name="name">tgm.flipbook.list</field>
        <field name="model">tgm.flipbook</field>
        <field name="arch" type="xml">
            <list string="Flipbooks">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="has_pdf"/>
                <field name="pdf_size_str" string="Size"/>
                <field name="public_url" widget="url"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tgm_flipbook_form" model="ir.ui.view">
        <field name="name">tgm.flipbook.form</field>
        <field name="model">tgm.flipbook</field>
        <field name="arch" type="xml">
            <form string="Flipbook">
                <header>
                    <button name="action_open_upload"
                            type="object"
                            string="Upload PDF"
                            class="btn-primary"
                            invisible="id == False"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1><field name="name" placeholder="Spring 2026 Catalogue"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug" placeholder="spring-2026"/>
                            <field name="public_url" widget="url" readonly="1"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="show_cover"/>
                        </group>
                    </group>
                    <group string="PDF">
                        <field name="has_pdf" invisible="1"/>
                        <field name="pdf_filename" readonly="1" invisible="not pdf_filename"/>
                        <field name="pdf_size_str" string="Size" invisible="not has_pdf"/>
                        <div colspan="2" invisible="has_pdf or not id" class="text-muted">
                            No PDF uploaded yet — click <b>Upload PDF</b> above.
                        </div>
                        <div colspan="2" invisible="id" class="text-muted">
                            Save the record first, then click <b>Upload PDF</b>.
                        </div>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tgm_flipbook" model="ir.actions.act_window">
        <field name="name">Flipbooks</field>
        <field name="res_model">tgm.flipbook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload your first PDF catalogue</p>
            <p>Upload a PDF and publish. The viewer lives at <code>/flipbook/&lt;slug&gt;</code> and renders pages in the browser via PDF.js.</p>
        </field>
    </record>

</odoo>
