<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tgm_min_qty_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.tgm.min.qty.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <h2>Minimum Order Quantity</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="tgm_min_qty_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="tgm_min_qty_enabled"/>
                            <div class="text-muted">
                                Enforce minimum order quantities per product on your website shop.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
