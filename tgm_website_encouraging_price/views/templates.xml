<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="encouraging_temp" active="False">
        <div id="encouraging_view" class="container m-0 mb-3 w-auto">Encouraging Price</div>
    </template>

    <template id="encouraging_product" inherit_id="website_sale.product">
        <xpath expr="//form//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-if="is_view_active('tgm_website_encouraging_price.encouraging_temp')" t-call="tgm_website_encouraging_price.encouraging_temp"/>
        </xpath>
    </template>
</odoo>
